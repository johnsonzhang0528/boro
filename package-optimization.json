{
  "name": "borojeet-blog-optimization",
  "version": "1.0.0",
  "description": "Performance optimization tools for BoroJeet blog",
  "scripts": {
    "images:convert": "node convert-to-webp.js",
    "images:watch": "node image-watcher.js",
    "images:single": "node convert-to-webp.js",
    "optimize:css": "cleancss -o assets/style.min.css assets/style.css",
    "optimize:js": "terser assets/lazy-load.js -o assets/lazy-load.min.js",
    "build:optimized": "npm run images:convert && npm run optimize:css && npm run optimize:js",
    "dev:watch": "npm run images:watch",
    "setup:hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit"
  },
  "devDependencies": {
    "sharp": "^0.32.6",
    "clean-css-cli": "^5.6.2",
    "terser": "^5.24.0",
    "chokidar": "^3.5.3",
    "glob": "^10.3.10"
  },
  "keywords": ["performance", "optimization", "images", "webp", "automation"],
  "author": "BoroJeet Team",
  "license": "MIT"
}