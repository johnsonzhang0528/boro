---
pagination:
  data: promotions.flat
  size: 1
  alias: item
permalink: "/promotions/{{ item.category.slug }}/{{ item.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ item.title }} | Borojeat Promotions"
  description: "{{ item.details | striptags | truncate(150) }}"
  category:
    slug: "{{ item.category.slug }}"
    name: "{{ item.category.name }}"
---

<div class="container mx-auto px-4 py-8">
  <nav class="mb-4 text-sm" aria-label="Breadcrumb">
    <ol class="list-none p-0 inline-flex flex-wrap">
      <li class="flex items-center">
        <a href="{{ '/' | url }}" class="text-blue-600 hover:text-blue-800">Home</a>
        <span class="mx-2">/</span>
      </li>
      <li class="flex items-center">
        <a href="{{ '/promotions/' | url }}" class="text-blue-600 hover:text-blue-800">Promotions</a>
        <span class="mx-2">/</span>
      </li>
      <li class="flex items-center">
        <a href="{{ '/promotions/' + category.slug + '/' | url }}" class="text-blue-600 hover:text-blue-800">{{ category.name }}</a>
        <span class="mx-2">/</span>
      </li>
      <li class="text-gray-500" aria-current="page">
        {{ item.title }}
      </li>
    </ol>
  </nav>

  <article>
    <h1 class="text-3xl font-bold mb-2">{{ item.title }}</h1>
    {% if item.startDate and item.endDate %}
    <div class="mb-4 text-sm text-gray-600">
        <p><strong>Promotion Period:</strong> {{ item.startDate }} to {{ item.endDate }}</p>
    </div>
    {% endif %}
    
    {% set image_base = item.image | replace(".webp", "") | replace(".jpg", "") | replace(".png", "") | replace(".avif", "") %}
    <picture class="content-image mb-6 max-w-3xl mx-auto">
      <source srcset="{{ (image_base + '.avif') | url }}" type="image/avif">
      <source srcset="{{ (image_base + '.webp') | url }}" type="image/webp">
      <img src="{{ (image_base + '.webp') | url }}"
           alt="{{ item.title }}"
           width="800" height="450" loading="lazy" decoding="async"
           class="w-full h-auto object-cover rounded-lg">
    </picture>

    <div class="prose max-w-none">
      <p class="lead text-lg">{{ item.details }}</p>
      
      <div class="mt-6 p-4 border rounded-lg bg-gray-50">
        <h2 class="text-xl font-semibold mb-3">Promotion Rules</h2>
        <ul class="list-disc pl-5 space-y-2">
          {% for rule in item.rules %}
            <li>{{ rule }}</li>
          {% endfor %}
        </ul>
      </div>

      <div class="mt-8 p-6 border-l-4 border-emerald-400 bg-emerald-50/10 rounded-r-lg">
        <h2 class="text-2xl font-bold mb-3 text-emerald-300">How to Claim This Promotion</h2>
        <ol class="list-decimal pl-5 space-y-2 text-gray-300">
          <li><strong>Register/Login:</strong> Ensure you have an active BoroJeet account. If not, <a href="/go/borojeet" rel="nofollow noopener" target="_blank" class="text-emerald-400 hover:underline">register here</a>.</li>
          <li><strong>Meet Requirements:</strong> Check the specific eligibility criteria and minimum deposit (if any) for this promotion.</li>
          <li><strong>Activate Bonus:</strong> Navigate to the 'Promotions' section in your account and activate this offer.</li>
          <li><strong>Enjoy:</strong> Start playing and enjoy your bonus!</li>
        </ol>
        <p class="mt-4 text-sm text-gray-400">Always read the full terms and conditions before claiming any promotion.</p>
      </div>

      <div class="text-center mt-8">
        <a href="/go/borojeet" rel="sponsored nofollow noopener" target="_blank" class="cta text-xl px-8 py-4 rounded-full shadow-lg hover:shadow-emerald-400/40 transition-all duration-300">
          Claim Your {{ item.title }} Now!
        </a>
      </div>

    </div>
  </article>

  <div class="mt-12">
    <a href="{{ '/promotions/' + category.slug + '/' | url }}" class="text-blue-600 hover:text-blue-800">&larr; Back to {{ category.name }}</a>
  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Offer",
  "name": "{{ item.title }}",
  "description": "{{ item.details | striptags }}",
  "url": "{{ site.url }}{{ page.url }}",
  "image": "{{ site.url }}{{ item.image | url }}",
  "category": "{{ item.category.name }}",
  {% if item.startDate %}
  "validFrom": "{{ item.startDate }}",
  {% endif %}
  {% if item.endDate %}
  "validThrough": "{{ item.endDate }}",
  {% endif %}
  "availability": "https://schema.org/InStock",
  "offeredBy": {
    "@type": "Organization",
    "name": "BoroJeet"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ site.url }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Promotions",
      "item": "{{ site.url }}/promotions/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ category.name }}",
      "item": "{{ site.url }}/promotions/{{ category.slug }}/"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "{{ item.title }}",
      "item": "{{ site.url }}{{ page.url }}"
    }
  ]
}
</script>