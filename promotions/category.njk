---
pagination:
  data: promotions.all
  size: 1
  alias: promoCategory
permalink: "/promotions/{{ promoCategory.slug }}/"
layout: "base.njk"
eleventyComputed:
  title: "{{ promoCategory.category }} | BoroJeet Promotions"
  description: "{{ promoCategory.description }}"
---

<main class="wrap">
  <div class="breadcrumb">
    <a href="{{ '/' | url }}">Home</a> / 
    <a href="{{ '/promotions/' | url }}">Promotions</a> / 
    <span>{% if promoCategory.category %}{{ promoCategory.category }}{% else %}Category{% endif %}</span>
  </div>

  <h1 class="h1">{{ promoCategory.category }}</h1>
  <p>{{ promoCategory.description }}</p>
  <p class="text-md text-gray-600 mb-8">
    Explore all the exciting promotions available in the {{ promoCategory.category }} category at BoroJeet.
    We constantly update our offers to bring you the best value and enhance your gaming experience.
    Find your next big win here!
  </p>

  <div class="article-list">
    {% for item in promoCategory.items %}
      {% set image_base = item.image | replace(".webp", "") | replace(".jpg", "") | replace(".png", "") | replace(".avif", "") %}
      <article class="card">
        <a href="{{ '/promotions/' + promoCategory.slug + '/' + item.slug + '/' | url }}" class="card-image-link">
          <picture class="content-image">
            <source srcset="{{ (image_base + '.avif') | url }}" type="image/avif">
            <source srcset="{{ (image_base + '.webp') | url }}" type="image/webp">
            <img src="{{ (image_base + '.webp') | url }}"
                 alt="{{ item.title }}"
                 width="800" height="450" loading="lazy" decoding="async"
                 sizes="(max-width: 768px) 100vw, 33vw">
          </picture>
        </a>
        <div class="p-4">
          <h2><a href="{{ '/promotions/' + promoCategory.slug + '/' + item.slug + '/' | url }}">{{ item.title }}</a></h2>
          <p>{{ item.details }}</p>
          <a href="{{ '/promotions/' + promoCategory.slug + '/' + item.slug + '/' | url }}">Read More &rarr;</a>
        </div>
      </article>
    {% endfor %}
  </div>

  <div class="mt-12">
    <a href="{{ '/promotions/' | url }}" class="text-blue-600 hover:text-blue-800">&larr; Back to all promotions</a>
  </div>
</main>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{ promoCategory.category }} | BoroJeet Promotions",
  "description": "{{ promoCategory.description }}",
  "url": "{{ site.url }}{{ page.url }}",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {% for item in promoCategory.items %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "url": "{{ site.url }}/promotions/{{ promoCategory.slug }}/{{ item.slug }}/",
        "name": "{{ item.title }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ site.url }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Promotions",
      "item": "{{ site.url }}/promotions/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ promoCategory.category }}",
      "item": "{{ site.url }}{{ page.url }}"
    }
  ]
}
</script>