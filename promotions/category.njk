---
pagination:
  data: promotions
  size: 1
  alias: promoCategory
permalink: "/promotions/{{ promoCategory.slug }}/"
layout: "post.njk"
---

<h1>{{ promoCategory.category }}</h1>
<p>{{ promoCategory.description }}</p>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "{{ promoCategory.category }} Promotions",
  "description": "{{ promoCategory.description }}",
  "numberOfItems": "{{ promoCategory.items | length }}",
  "itemListElement": [
    {% for item in promoCategory.items %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "item": {
        "@type": "Promotion",
        "name": "{{ item.title }}",
        {% if item.image %}"image": "{{ site.url }}{{ item.image }}",{% endif %}
        "description": "{{ item.details.Headline or promoCategory.description }}",
        {% if item.details['Promotional Period'] %}
        "startDate": "{{ item.details['Promotional Period'] | replace('~', ' - ') | split(' - ')[0] | date('YYYY-MM-DD') }}",
        "endDate": "{{ item.details['Promotional Period'] | replace('~', ' - ') | split(' - ')[1] | date('YYYY-MM-DD') }}",
        {% endif %}
        "url": "{{ site.url }}{{ page.url }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

<hr>

{% for item in promoCategory.items %}
  <article>
    <h2>{{ item.title }}</h2>
    
    {% if item.image %}
      <picture class="content-image">
        <source srcset="{{ item.image | replace('.webp', '.avif') }}" type="image/avif">
        <source srcset="{{ item.image }}" type="image/webp">
        <img src="{{ item.image }}"
             alt="{{ item.title }}"
             width="1024" height="576" loading="lazy" decoding="async"
             sizes="(max-width: 600px) 100vw, 1024px">
      </picture>
    {% endif %}

    <h3>অফারের বিবরণ:</h3>
    <table class="table">
      {% for key, value in item.details %}
        <tr>
          <td><strong>{{ key }}</strong></td>
          <td>{{ value }}</td>
        </tr>
      {% endfor %}
    </table>

    <div class="card cta-card">
      <h3>আপনার বোনাস দাবি করুন</h3>
      <a class="cta" href="/go/borojeet" rel="sponsored nofollow" target="_blank">এখনই ডিপোজিট করুন</a>
    </div>
  </article>
  <hr>
{% endfor %}