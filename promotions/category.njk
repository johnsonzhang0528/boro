---
pagination:
  data: promotions
  size: 1
  alias: promoCategory
permalink: "/promotions/{{ promoCategory.slug }}/"
layout: "post.njk"
title: "{{ promoCategory.category }} - BoroJeet BD Promotions"
description: "{{ promoCategory.description }}"
---

<h1>{{ promoCategory.category }}</h1>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "{{ promoCategory.category | escape }} Promotions",
  "description": "{{ promoCategory.description | escape }}",
  "numberOfItems": "{{ promoCategory.items | length }}",
  "itemListElement": [
    {% for item in promoCategory.items %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "item": {
        "@type": "Promotion",
        "name": "{{ item.title | escape }}",
        {% if item.image %}"image": "{{ (site.url | default('')) + (item.image | default('')) | escape }}",{% endif %}
        "description": "{{ item.details.Headline | default(promoCategory.description) | escape }}",
        "url": "{{ (site.url | default('')) + (page.url | default('')) | escape }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

<hr>

{% for item in promoCategory.items %}
  <article>
    <h2>{{ item.title }}</h2>
    
    {% if item.image %}
      <picture class="content-image">
        <source srcset="{{ item.image | replace('.webp', '.avif') }}" type="image/avif">
        <source srcset="{{ item.image }}" type="image/webp">
        <img src="{{ item.image }}"
             alt="{{ item.title }}"
             width="1024" height="576" loading="lazy" decoding="async"
             sizes="(max-width: 600px) 100vw, 1024px">
      </picture>
    {% endif %}

    <h3>অফারের বিবরণ:</h3>
    <table class="table">
      {% for key, value in item.details %}
        <tr>
          <td><strong>{{ key }}</strong></td>
          <td>
            {{ value }}
            {% if key == "Turnover" or key == "Bonus Turnover" or key == "Turnover Requirement" %}
              <a href="/blog/understanding-wagering-requirements/" class="note">(ওয়েজারিং রিকোয়ারমেন্ট বুঝুন)</a>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>

    <div class="card cta-card">
      <h3>আপনার বোনাস দাবি করুন</h3>
      <a class="cta" href="/go/borojeet" rel="sponsored nofollow" target="_blank">এখনই ডিপোজিট করুন</a>
    </div>
  </article>
  <hr>
{% endfor %}