---
layout: "base.njk"
title: "BoroJeet Promotions: All Bonuses and Offers"
description: "Explore all promotions and bonuses available for players in Bangladesh at BoroJeet. Updated daily with the latest offers."
date: 2025-11-09
---

<div class="wrap py-6 md:py-10">
  <div class="text-center mb-8 md:mb-12">
    <h1 class="h1 text-3xl md:text-4xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400">BoroJeet Promotions & Bonus Offers</h1>
    <p class="text-base md:text-lg text-muted">Discover all the exciting bonuses and offers available at BoroJeet.</p>
  </div>

  <div class="promo-page-container">
    <!-- Category Quick Filter with Swiper -->
    <div class="promo-filter-container sticky top-[60px] z-40">
      <div class="promo-filter-wrapper">
        <!-- Prev Button -->
        <div class="swiper-button-prev promo-nav-btn"></div>
        
        <!-- Swiper -->
        <div class="swiper-container promo-filter-swiper">
          <div class="swiper-wrapper">
            {% for category in promotions.all %}
              <a href="#{{ category.slug }}" class="swiper-slide inline-block px-4 py-2 text-sm font-semibold bg-gray-700/50 text-text rounded-full hover:bg-emerald-500 hover:text-white transition-all duration-300">{{ category.category }}</a>
            {% endfor %}
          </div>
        </div>

        <!-- Next Button -->
        <div class="swiper-button-next promo-nav-btn"></div>
      </div>
    </div>

    {% for category in promotions.all %}
      <section id="{{ category.slug }}" class="promo-category-wrapper category-wrapper scroll-mt-24">
        <div class="mb-6 md:mb-8">
          <h2 class="text-2xl md:text-3xl font-bold border-l-4 border-emerald-400 pl-4">
            <a href="{{ '/promotions/' + category.slug + '/' | url }}" class="hover:text-emerald-400 transition-colors">{{ category.category }}</a>
          </h2>
          <p class="text-md text-muted mt-2 pl-5">{{ category.description }}</p>
        </div>
        
        <div class="flex flex-col">
          {% for item in category.items %}
            {% if not loop.first %}
              <hr class="border-gray-700 my-6" />
            {% endif %}
            <a href="{{ '/promotions/' + category.slug + '/' + item.slug + '/' | url }}" class="group flex flex-col sm:flex-row bg-card border border-gray-700/50 rounded-xl overflow-hidden shadow-lg hover:shadow-emerald-400/20 transition-all duration-300 transform hover:-translate-y-1">
              <div class="relative overflow-hidden sm:w-1/3">
                <img src="{{ item.image | url }}" alt="{{ item.title }}" class="w-full h-48 sm:h-full object-cover transition-transform duration-300 group-hover:scale-105">
              </div>
              <div class="p-4 flex flex-col flex-grow sm:w-2/3">
                <h3 class="text-xl font-bold text-emerald-400 mb-2 group-hover:text-emerald-300 transition-colors">{{ item.title }}</h3>
                <p class="text-gray-300 text-base flex-grow">{{ item.details }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
</div>

<style>
.scrollbar-hide::-webkit-scrollbar {
    display: none;
}
.scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
}

/* Styles for visual separation */
/* New styles for the filter container */
.promo-filter-container {
  background: rgba(23, 31, 47, 0.85);
  backdrop-filter: blur(12px);
  border-radius: 12px;
  border: 1px solid rgba(55, 65, 81, 0.7);
  border-top: 1px solid rgba(75, 85, 99, 0.9);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
  padding: 4px 8px;
}

.promo-filter-wrapper {
  display: flex;
  align-items: center;
  width: 100%;
}

.promo-filter-swiper {
  flex-grow: 1;
  min-width: 0; /* Important for flex-grow to work correctly */
  overflow: hidden; /* Prevents content from pushing out the container */
}

.promo-filter-swiper .swiper-wrapper {
  justify-content: flex-start;
}

/* Swiper.js override for auto width slides */
.promo-filter-swiper .swiper-slide {
  width: auto;
}

/* Custom Swiper Navigation Arrows */
.promo-nav-btn {
  position: static;
  top: auto;
  left: auto;
  right: auto;
  transform: none;
  width: 32px;
  height: 32px;
  background-color: rgba(17, 24, 39, 0.8);
  border-radius: 50%;
  transition: background-color 0.2s ease;
  margin: 0 4px;
  flex-shrink: 0;
  color: var(--accent);
}
.promo-nav-btn:hover {
  background-color: rgba(31, 41, 55, 0.9);
}
.promo-nav-btn::after {
  font-size: 16px;
  font-weight: bold;
}

/* Override Swiper's default margin for statically positioned nav buttons */
.promo-filter-wrapper > .promo-nav-btn {
  margin-top: 0;
}

.swiper-button-disabled {
  opacity: 0.35;
  cursor: not-allowed;
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var swiper = new Swiper('.promo-filter-swiper', {
      slidesPerView: 'auto',
      spaceBetween: 8,
      freeMode: true,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  });
</script>

