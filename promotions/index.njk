---
layout: "base.njk"
title: "BoroJeet বোনাস ও প্রমোশন ২০২৬ — আজকের সব অফার এক পেজে"
description: "BoroJeet-এর সব চলতি অফার: ওয়েলকাম বোনাস, ডেইলি লগইন ড্র, ক্যাশব্যাক ও রিবেট — শর্ত ও ক্লেইম করার নিয়মসহ প্রতিদিন আপডেট।"
date: 2025-11-09
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [
    {% for category in promotions.all %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "url": "{{ site.url }}/promotions/{{ category.slug }}/",
      "name": "{{ category.category }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
<link rel="stylesheet" href="/assets/css/swiper/swiper-bundle.min.css" />
<main class="wrap">
  <div class="breadcrumb">
    <a href="{{ '/' | url }}">Home</a> / 
    <span>Promotions</span>
  </div>

  <div class="wrap py-6 md:py-10">
    <div class="text-center mb-8 md:mb-12">
      <h1 class="h1 text-3xl md:text-4xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400">BoroJeet Promotions & Bonus Offers</h1>
      <p class="text-base md:text-lg text-muted">Discover all the exciting bonuses and offers available at BoroJeet.</p>
      <p class="text-md text-muted mt-4 max-w-3xl mx-auto">
        At BoroJeet, we believe in rewarding our players with the most exciting and generous promotions in Bangladesh.
        Whether you're a new player looking for a welcome bonus or a loyal customer seeking daily rewards,
        our diverse range of offers ensures there's always something special for everyone.
        Explore our categories below to find the perfect bonus to boost your gaming experience!
      </p>
    </div>

    <div class="promo-page-container">
      <!-- Category Quick Filter with Swiper -->
      <div class="promo-filter-container sticky top-[60px] z-40">
        <div class="promo-filter-wrapper">
          <!-- Swiper -->
          <div class="swiper-container promo-filter-swiper">
            <div class="swiper-wrapper">
              {% for category in promotions.all %}
                <a href="#{{ category.slug }}" class="swiper-slide inline-block px-4 py-2 text-sm font-semibold bg-gray-700/50 text-text rounded-full hover:bg-emerald-500 hover:text-white transition-all duration-300">{{ category.category }}</a>
              {% endfor %}
            </div>
          </div>

        </div>
      </div>

      {% for category in promotions.all %}
        <section id="{{ category.slug }}" class="promo-category-wrapper category-wrapper scroll-mt-24">
          <div class="mb-6 md:mb-8">
            <h2 class="text-2xl md:text-3xl font-bold border-l-4 border-emerald-400 pl-4">
              <a href="{{ '/promotions/' + category.slug + '/' | url }}" class="hover:text-emerald-400 transition-colors">{{ category.category }}</a>
            </h2>
            <p class="text-md text-muted mt-2 pl-5">{{ category.description }}</p>
          </div>
          
          <div class="flex flex-col divide-y divide-gray-700">
            {% for item in category.items %}
              {% set image_base = item.image | replace(".webp", "") | replace(".jpg", "") | replace(".png", "") | replace(".avif", "") %}
              <a href="{{ '/promotions/' + category.slug + '/' + item.slug + '/' | url }}" class="group flex flex-col sm:flex-row bg-card border border-gray-700/50 rounded-xl overflow-hidden shadow-lg hover:shadow-emerald-400/20 transition-all duration-300 transform hover:-translate-y-1 pt-6 first:pt-0">
                <div class="relative overflow-hidden sm:w-1/3">
                  <picture class="content-image">
                    <source srcset="{{ (image_base + '.avif') | url }}" type="image/avif">
                    <source srcset="{{ (image_base + '.webp') | url }}" type="image/webp">
                    <img src="{{ (image_base + '.webp') | url }}"
                        alt="{{ item.title }}"
                        width="800" height="450" loading="lazy" decoding="async"
                        sizes="(min-width: 640px) 33vw, 100vw">
                  </picture>
                </div>
                <div class="p-4 flex flex-col flex-grow sm:w-2/3">
                  <h3 class="text-xl font-bold text-emerald-400 mb-2 group-hover:text-emerald-300 transition-colors">{{ item.title }}</h3>
                  <p class="text-gray-300 text-base flex-grow">{{ item.details }}</p>
                </div>
              </a>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    </div>
  </div>
</main>

<script src="/assets/swiper-bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var swiper = new Swiper('.promo-filter-swiper', {
      slidesPerView: 'auto',
      spaceBetween: 8,
      freeMode: true,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  });
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{ title }}",
  "description": "{{ description }}",
  "url": "{{ site.url }}{{ page.url }}",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {% for category in promotions.all %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "url": "{{ site.url }}/promotions/{{ category.slug }}/",
        "name": "{{ category.category }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
}
</script>
