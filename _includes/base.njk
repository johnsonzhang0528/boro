        "name": "{{ step.name }}",
        "text": "{{ step.text }}",
        "url": "{{ site.url }}{{ page.url }}#step-{{ loop.index }}",
        "image": "{{ site.url }}/assets/og/{{ step.image or ogImage or 'og-default-optimized.webp' }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
