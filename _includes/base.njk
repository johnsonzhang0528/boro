  }
  </script>
  {% endif %}

  <!-- Google tag (gtag.js) - Optimized for user interaction -->
  <script>
    // Load analytics only after user interaction to reduce initial blocking
    function loadGoogleAnalytics() {
      if (window.gtag) return; // Prevent multiple loads
      
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-P6KSF9FS0T';
      document.head.appendChild(script);
      
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-P6KSF9FS0T', {
        page_title: '{{ title }}',
        page_location: window.location.href
      });
    }

    // Load analytics on first user interaction
    ['scroll', 'click', 'touchstart', 'keydown'].forEach(event => {
      document.addEventListener(event, loadGoogleAnalytics, { once: true, passive: true });
    });
    
    // Fallback: load after 10 seconds if no interaction
    setTimeout(loadGoogleAnalytics, 10000);
  </script>

