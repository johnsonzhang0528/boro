  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- Only preconnect to GTM when analytics will load on interaction -->
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
  
  <!-- Optimize font loading to prevent FOUT/FOUC -->
  <style>
    /* System font fallback to prevent FOUT */
    @font-face {
      font-family: 'system-ui-fallback';
      src: local('system-ui'), local('-apple-system'), local('BlinkMacSystemFont'), local('Segoe UI'), local('Roboto');
      font-display: block; /* Block briefly to prevent FOUT */
    }
  </style>
  
  <!-- Load main stylesheet -->
  <link rel="stylesheet" href="/assets/style.min.css">
  <link rel="stylesheet" href="/assets/css/components/promo-filter.css">
  
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ canonicalUrl or site.url + page.url }}">
  {% if pagination.href.previous %}
    <link rel="prev" href="{{ site.url }}{{ pagination.href.previous }}">
  {% endif %}
  {% if pagination.href.next %}
    <link rel="next" href="{{ site.url }}{{ pagination.href.next }}">
  {% endif %}
  {% if robots %}
    <meta name="robots" content="{{ robots }}">
  {% endif %}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="{% if page.url.startsWith('/blog/') %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ canonicalUrl or site.url + page.url }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ lang or 'bn-BD' }}">

  {# --- OG Image Dynamic Logic --- #}
  {% if page.url == '/' %}
    <meta property="og:image" content="{{ site.url }}/assets/og/hero-optimized.webp">
  {% elif ogImage %}
    {% if ogImage.startsWith('/') or ogImage.startsWith('http') %}
      <meta property="og:image" content="{{ site.url }}{{ ogImage }}">
    {% else %}
      <meta property="og:image" content="{{ site.url }}/assets/og/{{ ogImage }}">
    {% endif %}
  {% else %}
    <meta property="og:image" content="{{ site.url }}/assets/og/og-default-optimized.webp">
  {% endif %}

  {% if ogImageAlt %}
    <meta property="og:image:alt" content="{{ ogImageAlt }}">
  {% endif %}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="{{ canonicalUrl or site.url + page.url }}">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  
  {# --- Twitter Image Logic (Same as OG) --- #}
  {% if page.url == '/' %}
    <meta name="twitter:image" content="{{ site.url }}/assets/og/hero-optimized.webp">
  {% elif ogImage %}
    {% if ogImage.startsWith('/') or ogImage.startsWith('http') %}
