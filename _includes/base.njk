<!DOCTYPE html>
<html lang="{{ lang or 'bn-BD' }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <script>
    // Prevent FOUC by setting the background color immediately, matching --bg in CSS
    document.documentElement.style.background = '#0b0f14';
  </script>
  <style>
    /* Critical CSS to prevent CLS and FOUC */
    :root {
      --bg: #0b0f14;
      --text: #e9f2ff;
      --muted: #9db1c9;
      --accent: #10b981;
      --accent-2: #ef4444;
      --card: #111827;
      --bdt: #22d3ee;
      --maxw: 1120px;
    }
    * { box-sizing: border-box; }
    figure { margin: 0; }
    html, body { height: 100%; }
    body {
      margin: 0;
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", "Helvetica Neue", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
      font-display: optional;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }
    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 16px; }
    .h1 { font-size: clamp(28px, 4vw, 42px); line-height: 1.15; margin: 6px 0 10px; letter-spacing: .2px; }
    .breadcrumb { font-size: 14px; color: var(--muted); margin-top: 0; }
    .post-meta { color: var(--muted); font-size: 14px; margin-bottom: 16px; }
    a { color: #A8DFFD; text-decoration: none; }

    /* Consolidated Header styles for immediate rendering */
    header { position: sticky; top: 0; z-index: 50; backdrop-filter: blur(8px); background: rgba(11,15,20,.8); border-bottom: 1px solid #1f2937; }
    header .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .logo { display: flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: .1px; }
    .logo span { white-space: nowrap; }
    .logo img { height: 20px; width: auto; border-radius: 4px; }
    nav { display: flex; align-items: center; gap: 16px; } /* Moved from inline style */
    .cta {
      display: inline-flex; align-items: center; justify-content: center;
      gap: .5rem; background: var(--accent); color: #041b11; font-weight: 700;
      padding: 10px 16px; border-radius: 12px; border: 1px solid #064e3b;
      box-shadow: 0 6px 20px rgba(16,185,129,.25);
    }
    .cta:hover { filter: brightness(1.05); text-decoration: none; }
    [aria-current="page"] {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
    @media (max-width: 768px) {
      header .row {
        flex-direction: column;
        gap: 8px;
        align-items: center;
      }
    }
  </style>
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {% if canonicalUrl %}
    <link rel="canonical" href="{{ canonicalUrl }}">
  {% endif %}
  {% if robots %}
    <meta name="robots" content="{{ robots }}">
  {% endif %}

  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  {% if canonicalUrl %}
    <meta property="og:url" content="{{ canonicalUrl }}">
  {% else %}
    <meta property="og:url" content="https://borojeetbd.com{{ page.url }}">
  {% endif %}
  {# --- OG Image Dynamic Logic --- #}
  {% if page.url == '/' %}
    <meta property="og:image" content="https://borojeetbd.com/assets/og/hero.jpg">
  {% elif ogImage %}
    <meta property="og:image" content="https://borojeetbd.com/assets/og/{{ ogImage }}">
  {% else %}
    <meta property="og:image" content="https://borojeetbd.com/assets/og/og-default.jpg">
  {% endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ lang or 'bn-BD' }}">

  <link rel="preload" href="/assets/style.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/assets/style.css"></noscript>

  {% if page.url == '/' %}
  <link rel="preload" href="/assets/borojeet-bangladesh-bonus-bkash-nagad.webp" as="image" fetchpriority="high">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "BoroJeet Affiliate BD",
    "url": "https://borojeetbd.com/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://borojeetbd.com/search?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  {% endif %}

  <!-- Google tag (gtag.js) -->
  <script defer src="https://www.googletagmanager.com/gtag/js?id=G-P6KSF9FS0T"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-P6KSF9FS0T');
  </script>
</head>
<body>
  <header>
    <div class="wrap row">
      <a href="/" class="logo">
        <img src="/assets/borojeet-affiliate-logo-bd.webp" alt="BoroJeet Bangladesh Logo" width="71" height="20">
        <span>BoroJeet Affiliate BD</span>
      </a>
      <nav aria-label="Primary">
        <a href="/blog/" style="font-weight: 600;"{% if page.url.startsWith('/blog/') %} aria-current="page"{% endif %}>Blog</a>
        <a class="cta" href="/go/borojeet" rel="sponsored nofollow" target="_blank">Get Bonus / নিবন্ধন করুন</a>
      </nav>
    </div>
  </header>

  {{ content | safe }}

  <footer class="wrap">
    <p>© <span id="year">2025</span> BoroJeet Affiliate BD.
      <a href="/about/">About Us</a> •
      <a href="/terms/">Terms</a> •
      <a href="/kyc/">KYC Policy</a> •
      <a href="/privacy/">Privacy</a> •
      <a href="/responsible-gaming/">Responsible Gaming</a> •
      <a href="/underage-gaming/">Underage Gaming Policy</a> •
      <a href="/anti-money-laundering/">Anti-Money Laundering Policy</a>
    </p>
    <p class="note">
      This site promotes BoroJeet to users in Bangladesh as an authorized affiliate.
      We do not operate or provide gambling services.
      Play responsibly. Offers are subject to change.
    </p>
  </footer>

  <script>
    (function(){
      var y = document.getElementById('year');
      if(y){ y.textContent = new Date().getFullYear(); }
      var updated = document.querySelector('.last-updated');
      if(updated) { updated.textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); }
    })();
  </script>
</body>
</html>