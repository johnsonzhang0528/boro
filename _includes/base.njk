    "name": "{{ howto.name or title }}",
    "description": "{{ howto.description or description }}",
    "image": {
      "@type": "ImageObject",
      "url": "{{ site.url }}/assets/og/{{ ogImage or 'og-default-optimized.webp' }}"
    },
    "step": [
      {% for step in howto.steps %}
