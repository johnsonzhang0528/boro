    {% else %}
      <meta name="twitter:image" content="{{ site.url }}/assets/og/{{ ogImage }}">
    {% endif %}
  {% else %}
    <meta name="twitter:image" content="{{ site.url }}/assets/og/og-default-optimized.webp">
  {% endif %}

  {% if ogImageAlt %}
    <meta name="twitter:image:alt" content="{{ ogImageAlt }}">
  {% endif %}


  
  <!-- Preload critical fonts -->
