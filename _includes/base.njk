  <!-- Google tag (gtag.js) - Optimized for performance -->
  <script>
    // Use requestIdleCallback to defer analytics initialization
    function loadGoogleAnalytics() {
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-P6KSF9FS0T';
      document.head.appendChild(script);
      
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-P6KSF9FS0T', {
        page_title: '{{ title }}',
        page_location: window.location.href
      });
    }

    // Load analytics when browser is idle or after 2 seconds (reduced from 3)
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadGoogleAnalytics, { timeout: 2000 });
    } else {
      setTimeout(loadGoogleAnalytics, 2000);
    }
  </script>
</head>
<body>
