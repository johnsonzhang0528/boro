---
layout: "base.njk"
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "image": "{{ site.url }}/assets/og/{{ ogImage or 'og-default-optimized.webp' }}",
  "datePublished": "{{ page.date.toISOString() }}",
  "dateModified": "{{ (lastUpdated or page.date).toISOString() }}",
  "author": {
    "@type": "Person",
    "name": "BoroJeet Expert",
    "url": "{{ site.url }}/about/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "BoroJeet Affiliate BD",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}/assets/borojeet-affiliate-logo-bd.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "{{ site.url }}/"
  },{
    "@type": "ListItem",
    "position": 2,
    "name": "Blog",
    "item": "{{ site.url }}/blog/"
  },{
    "@type": "ListItem",
    "position": 3,
    "name": "{{ title }}",
    "item": "{{ site.url }}{{ page.url }}"
  }]
}
</script>

<main class="wrap">
  <div class="breadcrumb">
    <a href="{{ '/' | url }}">Home</a> / 
    <a href="/blog/">Blog</a> / 
    <span>{{ title }}</span>
  </div>
  <article>
    <h1 class="h1">{{ title }}</h1>
    <div class="post-meta">By BoroJeet BD Team • Published on {{ page.date | date("MMMM dd, yyyy") }}{% if lastUpdated %} • <span class="warn">Updated on {{ lastUpdated | date("MMMM dd, yyyy") }}</span>{% endif %}</div>
    <div class="post-content">
      {{ content | safe }}
    </div>
  </article>

  <style>
    .author-box {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid #243041;
      border-radius: 16px;
      padding: 20px;
      margin-top: 40px;
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .author-box img {
      border-radius: 50%;
      width: 100px;
      height: 100px;
      object-fit: cover;
      flex-shrink: 0;
    }
    .author-info h4 {
      margin: 0 0 8px;
      font-size: 1.1rem;
      color: var(--text);
    }
    .author-info p {
      margin: 0;
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.5;
    }
  </style>
  <div class="author-box">
    <picture>
      <source srcset="/assets/authors/borojeet-expert-optimized.avif" type="image/avif">
      <source srcset="/assets/authors/borojeet-expert-optimized.webp" type="image/webp">
      <img src="/assets/authors/borojeet-expert-optimized.webp" alt="BoroJeet Expert" class="author-image" width="100" height="100">
    </picture>
    <div class="author-info">
      <h2>About the Author: BoroJeet Expert</h2>
      <p>An experienced analyst in the iGaming sector, focusing on the Bangladesh market. Dedicated to providing safe, reliable, and up-to-date information for players. <a href="/about/">Learn more about our editorial standards</a>.</p>
    </div>
  </div>

  {# --- Related Posts Section --- #}
  <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid #243041;">
    <h3 style="font-size: 1.5rem; margin-bottom: 24px;">আরও পড়ুন (Related Posts)</h3>
    <div class="grid grid-2">
      {% set relatedCount = 0 %}
      {% for post in collections.post %}
        {% if post.url != page.url and relatedCount < 2 %}
          <div class="card">
            <div class="card-meta">{{ post.date | date("MMMM dd, yyyy") }}</div>
            <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            <p>{{ post.data.description | truncate(100) }}</p>
          </div>
          {% set relatedCount = relatedCount + 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</main>
