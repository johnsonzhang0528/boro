---
layout: "base.njk"
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "image": "{{ site.url }}/assets/og/{{ ogImage or 'og-default-optimized.webp' }}",
  "datePublished": "{{ page.date.toISOString() }}",
  "dateModified": "{{ (lastUpdated or page.date).toISOString() }}",
  "author": {
    "@type": "Person",
    "name": "BoroJeet Expert",
    "url": "{{ site.url }}/authors/borojeet-expert/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "BoroJeet Affiliate BD",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}/assets/borojeet-affiliate-logo-bd.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "{{ site.url }}/"
  },{
    "@type": "ListItem",
    "position": 2,
    "name": "Blog",
    "item": "{{ site.url }}/blog/"
  },{
    "@type": "ListItem",
    "position": 3,
    "name": "{{ title }}",
    "item": "{{ site.url }}{{ page.url }}"
  }]
}
</script>

<main class="wrap">
  <div class="breadcrumb">
    <a href="{{ '/' | url }}">Home</a> / 
    <a href="/blog/">Blog</a> / 
    <span>{{ title }}</span>
  </div>
  <article>
    <h1 class="h1">{{ title }}</h1>
    <div class="post-meta">By BoroJeet BD Team • Published on {{ page.date | date("MMMM dd, yyyy") }}{% if lastUpdated %} • <span class="warn">Updated on {{ lastUpdated | date("MMMM dd, yyyy") }}</span>{% endif %}</div>
    
    {# --- Table of Contents (TOC) --- #}
    <div class="toc-container">
      <details open>
        <summary>Table of Contents</summary>
        <div class="toc-content">
          {{ content | toc | safe }}
        </div>
      </details>
    </div>

    <div class="post-content">
      {{ content | safe }}
    </div>
  </article>

  <style>
    /* TOC Styles */
    .toc-container {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid #243041;
      border-radius: 12px;
      margin-bottom: 32px;
      font-size: 0.95rem;
    }
    .toc-container details {
      padding: 16px;
    }
    .toc-container summary {
      cursor: pointer;
      font-weight: 700;
      color: var(--accent);
      list-style: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .toc-container summary::before {
      content: '▶';
      font-size: 0.8em;
      transition: transform 0.2s;
    }
    .toc-container details[open] summary::before {
      transform: rotate(90deg);
    }
    .toc-content {
      margin-top: 12px;
      padding-left: 12px;
      border-left: 2px solid #243041;
    }
    .toc-content ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .toc-content li {
      margin: 8px 0;
    }
    .toc-content a {
      color: var(--muted);
      text-decoration: none;
      transition: color 0.2s;
    }
    .toc-content a:hover {
      color: var(--text);
      text-decoration: underline;
    }
    
    .author-box {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid #243041;
      border-radius: 16px;
      padding: 20px;
      margin-top: 40px;
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .author-box img {
      border-radius: 50%;
      width: 100px;
      height: 100px;
      object-fit: cover;
      flex-shrink: 0;
    }
    .author-info h4 {
      margin: 0 0 8px;
      font-size: 1.1rem;
      color: var(--text);
    }
    .author-info p {
      margin: 0;
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.5;
    }

    /* FAQ Styles */
    .faq-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid #243041;
      border-radius: 12px;
      margin-bottom: 16px;
    }
    .faq-item summary {
      padding: 16px;
      cursor: pointer;
      font-weight: 600;
      list-style: none;
      position: relative;
      padding-right: 40px;
    }
    .faq-item summary::-webkit-details-marker {
      display: none;
    }
    .faq-item summary::after {
      content: '+';
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.5em;
      color: var(--accent);
    }
    .faq-item[open] summary::after {
      content: '-';
    }
    .faq-answer {
      padding: 0 16px 16px;
      color: var(--muted);
      line-height: 1.6;
    }
  </style>
  <div class="author-box">
    <picture>
      <source srcset="/assets/authors/borojeet-expert-optimized.avif" type="image/avif">
      <source srcset="/assets/authors/borojeet-expert-optimized.webp" type="image/webp">
      <img src="/assets/authors/borojeet-expert-optimized.webp" alt="BoroJeet Expert" class="author-image" width="100" height="100">
    </picture>
    <div class="author-info">
      <h2>About the Author: BoroJeet Expert</h2>
      <p>An experienced analyst in the iGaming sector, focusing on the Bangladesh market. Dedicated to providing safe, reliable, and up-to-date information for players. <a href="/authors/borojeet-expert/">View full profile & articles</a>.</p>
    </div>
  </div>

  {# --- FAQ Section --- #}
  {% if faq %}
  <div class="faq-section" style="margin-top: 60px; padding-top: 40px; border-top: 1px solid #243041;">
    <h2 class="h2">সচরাচর জিজ্ঞাসিত প্রশ্ন (FAQ)</h2>
    <div class="faq-list">
      {% for item in faq %}
      <details class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
        <summary itemprop="name">{{ item.question }}</summary>
        <div class="faq-answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <div itemprop="text">
            {{ item.answer | safe }}
          </div>
        </div>
      </details>
      {% endfor %}
    </div>
  </div>

  {% endif %}

  {# --- Related Posts Section --- #}
  <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid #243041;">
    <h3 style="font-size: 1.5rem; margin-bottom: 24px;">আরও পড়ুন (Related Posts)</h3>
    <div class="grid grid-2">
      {% set relatedCount = 0 %}
      {% set currentTags = tags | default([]) %}
      
      {# First pass: Look for posts with matching tags #}
      {% for post in collections.post %}
        {% if post.url != page.url and relatedCount < 2 %}
          {% set isRelated = false %}
          {% for tag in post.data.tags %}
            {% if tag != "post" and tag in currentTags %}
              {% set isRelated = true %}
            {% endif %}
          {% endfor %}
          
          {% if isRelated %}
            <div class="card">
              <div class="card-meta">{{ post.date | date("MMMM dd, yyyy") }}</div>
              <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
              <p>{{ post.data.description | truncate(100) }}</p>
            </div>
            {% set relatedCount = relatedCount + 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {# Second pass: Fill remaining spots with recent posts if needed #}
      {% if relatedCount < 2 %}
        {% for post in collections.post %}
          {% if post.url != page.url and relatedCount < 2 %}
            {# Check if we already added this post in the first pass to avoid duplicates #}
            {% set alreadyAdded = false %}
            {% for tag in post.data.tags %}
              {% if tag != "post" and tag in currentTags %}
                {% set alreadyAdded = true %}
              {% endif %}
            {% endfor %}

            {% if not alreadyAdded %}
              <div class="card">
                <div class="card-meta">{{ post.date | date("MMMM dd, yyyy") }}</div>
                <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
                <p>{{ post.data.description | truncate(100) }}</p>
              </div>
              {% set relatedCount = relatedCount + 1 %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</main>
