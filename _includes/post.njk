---
layout: "base.njk"
---
<main class="wrap">
  <div class="breadcrumb">
    <a href="/blog/">Blog</a> &gt; 
    <span>{{ title }}</span>
  </div>
  <article>
    <h1 class="h1">{{ title }}</h1>
    <div class="post-meta">By BoroJeet BD Team • Published on {{ page.date | date("MMMM dd, yyyy") }}</div>
    <div class="post-content">
      {{ content | safe }}
    </div>
  </article>
</main>
