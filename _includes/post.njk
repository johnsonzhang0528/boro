---
layout: "base.njk"
---

<div class="wrap">
  <div class="breadcrumb">
    <a href="{{ '/' | url }}">Home</a> / 
    <a href="/blog/">Blog</a> / 
    <span>{{ title }}</span>
  </div>
  <article>
    <h1 class="h1">{{ title }}</h1>
    <div class="post-meta">
      By BoroJeet BD Team • {{ content | readingTime }} • Published on {{ page.date | date("MMMM dd, yyyy") }}{% if lastUpdated %} • <span class="warn">Updated on {{ lastUpdated | date("MMMM dd, yyyy") }}</span>{% endif %}
    </div>
    
    {# --- Table of Contents (TOC) --- #}
    <div class="toc-container">
      <details open>
        <summary>Table of Contents</summary>
        <div class="toc-content">
          {{ content | toc | safe }}
        </div>
      </details>
    </div>

    <div class="post-content">
      {{ content | safe }}
    </div>

    <div class="share-section">
      <h3>Share this article</h3>
      <div class="share-buttons">
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ site.url }}{{ page.url }}" target="_blank" rel="noopener noreferrer" class="share-btn fb">Facebook</a>
        <a href="https://twitter.com/intent/tweet?text={{ title }}&url={{ site.url }}{{ page.url }}" target="_blank" rel="noopener noreferrer" class="share-btn tw">Twitter</a>
        <a href="https://api.whatsapp.com/send?text={{ title }} {{ site.url }}{{ page.url }}" target="_blank" rel="noopener noreferrer" class="share-btn wa">WhatsApp</a>
        <a href="https://t.me/share/url?url={{ site.url }}{{ page.url }}&text={{ title }}" target="_blank" rel="noopener noreferrer" class="share-btn tg">Telegram</a>
      </div>
    </div>
  </article>

  <style>
    /* Share Buttons */
    .share-section {
      margin: 40px 0;
      padding: 24px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid #243041;
      border-radius: 16px;
      text-align: center;
    }
    .share-section h3 {
      margin-top: 0;
      margin-bottom: 16px;
      font-size: 1.2rem;
    }
    .share-buttons {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .share-btn {
      padding: 8px 16px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      color: white;
      transition: opacity 0.2s;
    }
    .share-btn:hover {
      opacity: 0.9;
      text-decoration: none;
      color: white;
    }
    .fb { background: #105cb6; }
    .tw { background: #0c7abf; }
    .wa { background: #075e54; }
    .tg { background: #00619e; }

    /* TOC Styles */
    .toc-container {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid #243041;
      border-radius: 12px;
      margin-bottom: 32px;
      font-size: 0.95rem;
    }
    .toc-container details {
      padding: 16px;
    }
    .toc-container summary {
      cursor: pointer;
      font-weight: 700;
      color: var(--accent);
      list-style: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .toc-container summary::before {
      content: '▶';
      font-size: 0.8em;
      transition: transform 0.2s;
    }
    .toc-container details[open] summary::before {
      transform: rotate(90deg);
    }
    .toc-content {
      margin-top: 12px;
      padding-left: 12px;
      border-left: 2px solid #243041;
    }
    .toc-content ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .toc-content li {
      margin: 8px 0;
    }
    .toc-content a {
      color: var(--muted);
      text-decoration: none;
      transition: color 0.2s;
    }
    .toc-content a:hover {
      color: var(--text);
      text-decoration: underline;
    }
    
    .author-box {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid #243041;
      border-radius: 16px;
      padding: 20px;
      margin-top: 40px;
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .author-box img {
      border-radius: 50%;
      width: 100px;
      height: 100px;
      object-fit: cover;
      flex-shrink: 0;
    }
    .author-info h4 {
      margin: 0 0 8px;
      font-size: 1.1rem;
      color: var(--text);
    }
    .author-info p {
      margin: 0;
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.5;
    }

    /* FAQ Styles */
    .faq-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid #243041;
      border-radius: 12px;
      margin-bottom: 16px;
    }
    .faq-item summary {
      padding: 16px;
      cursor: pointer;
      font-weight: 600;
      list-style: none;
      position: relative;
      padding-right: 40px;
    }
    .faq-item summary::-webkit-details-marker {
      display: none;
    }
    .faq-item summary::after {
      content: '+';
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.5em;
      color: var(--accent);
    }
    .faq-item[open] summary::after {
      content: '-';
    }
    .faq-answer {
      padding: 0 16px 16px;
      color: var(--muted);
      line-height: 1.6;
    }
  </style>
  <div class="author-box">
    <picture>
      <source srcset="/assets/authors/borojeet-expert-optimized.avif" type="image/avif">
      <source srcset="/assets/authors/borojeet-expert-optimized.webp" type="image/webp">
      <img src="/assets/authors/borojeet-expert-optimized.webp" alt="BoroJeet Expert" class="author-image" width="100" height="100">
    </picture>
    <div class="author-info">
      <h2>About the Author: BoroJeet Expert</h2>
      <p>An experienced analyst in the iGaming sector, focusing on the Bangladesh market. Dedicated to providing safe, reliable, and up-to-date information for players. <a href="/authors/borojeet-expert/">View full profile & articles</a>.</p>
    </div>
  </div>

  {# --- FAQ Section --- #}
  {% if faq %}
  <div class="faq-section" style="margin-top: 60px; padding-top: 40px; border-top: 1px solid #243041;">
    <h2 class="h2">সচরাচর জিজ্ঞাসিত প্রশ্ন (FAQ)</h2>
    <div class="faq-list">
      {% for item in faq %}
      <details class="faq-item">
        <summary>{{ item.question }}</summary>
        <div class="faq-answer">
          <div>
            {{ item.answer | safe }}
          </div>
        </div>
      </details>
      {% endfor %}
    </div>
  </div>

  {% endif %}

  {# --- Related Posts Section --- #}
  <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid #243041;">
    <h3 style="font-size: 1.5rem; margin-bottom: 24px;">আরও পড়ুন (Related Posts)</h3>
    <div class="grid grid-2">
      {% set relatedCount = 0 %}
      {% set currentTags = tags | default([]) %}
      
      {# First pass: Look for posts with matching tags #}
      {% for post in collections.post %}
        {% if post.url != page.url and relatedCount < 2 %}
          {% set isRelated = false %}
          {% for tag in post.data.tags %}
            {% if tag != "post" and tag in currentTags %}
              {% set isRelated = true %}
            {% endif %}
          {% endfor %}
          
          {% if isRelated %}
            <div class="card">
              <div class="card-meta">{{ post.date | date("MMMM dd, yyyy") }}</div>
              <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
              <p>{{ post.data.description | truncate(100) }}</p>
            </div>
            {% set relatedCount = relatedCount + 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {# Second pass: Fill remaining spots with recent posts if needed #}
      {% if relatedCount < 2 %}
        {% for post in collections.post %}
          {% if post.url != page.url and relatedCount < 2 %}
            {# Check if we already added this post in the first pass to avoid duplicates #}
            {% set alreadyAdded = false %}
            {% for tag in post.data.tags %}
              {% if tag != "post" and tag in currentTags %}
                {% set alreadyAdded = true %}
              {% endif %}
            {% endfor %}

            {% if not alreadyAdded %}
              <div class="card">
                <div class="card-meta">{{ post.date | date("MMMM dd, yyyy") }}</div>
                <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
                <p>{{ post.data.description | truncate(100) }}</p>
              </div>
              {% set relatedCount = relatedCount + 1 %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>
