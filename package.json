{
  "name": "boro-affiliate-site",
  "version": "1.0.0",
  "description": "BoroJeet affiliate website",
  "main": ".eleventy.js",
  "scripts": {
    "build:css": "esbuild assets/style.css --bundle --minify --outfile=_site/assets/style.css",
    "start": "npx @11ty/eleventy --serve",
    "build": "node node_modules/@11ty/eleventy/cmd.js && npm run build:css",
    "images:convert": "node convert-to-webp.js",
    "images:watch": "node image-watcher.js",
    "images:single": "node convert-to-webp.js",
    "optimize:css": "cleancss -o assets/style.min.css assets/style.css",
    "optimize:js": "terser assets/lazy-load.js -o assets/lazy-load.min.js",
    "optimize:performance": "node performance-optimizer.js",
    "build:optimized": "npm run images:convert && npm run optimize:css && npm run optimize:js && npm run optimize:performance && npm run build",
    "build:production": "npm run build:optimized",
    "dev:watch": "npm run images:watch",
    "setup:hooks": "git config core.hooksPath .githooks",
    "test:performance": "lighthouse http://localhost:8080 --output=html --output-path=lighthouse-report.html",
    "audit:cls": "node -e \"console.log('Run: npm run test:performance to check CLS improvements')\""
  },
  "keywords": [
    "eleventy",
    "static-site-generator"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "chokidar": "^3.5.3",
    "clean-css-cli": "^5.6.2",
    "eleventy-plugin-toc": "^1.1.5",
    "esbuild": "^0.25.11",
    "glob": "^10.3.10",
    "luxon": "^3.7.2",
    "terser": "^5.24.0"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "sharp": "^0.34.4"
  }
}
