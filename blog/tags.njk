---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - post
    - posts
    - tagList
    - about
    - anti-money-laundering
    - index
    - privacy
    - terms
    - underage-gaming
    - page
    - archive
  addAllPagesToCollections: true
layout: base.njk
eleventyComputed:
  title: "Articles tagged with {{ tag | capitalize }}"
  description: "Explore our comprehensive guides, tips, and latest news about {{ tag | capitalize }} on BoroJeet. Stay updated with expert analysis."
tags: "archive"
permalink: /blog/tag/{{ tag | slug }}/
robots: "noindex"
---
<main class="wrap">
  <div class="breadcrumb">
    <a href="{{ '/' | url }}">Home</a> / 
    <a href="{{ '/blog/' | url }}">Blog</a> / 
    <span>{{ tag | capitalize }}</span>
  </div>

  <h1 class="h1">Articles tagged with "{{ tag | capitalize }}"</h1>

  <div class="article-list">
    {% set taglist = collections[ tag ] | publishedOnly %}
    {% for post in taglist | reverse %}
      <article class="card">
        {% if post.data.ogImage %}
        <a href="{{ post.url }}" class="card-image-link">
          <picture>
             <source srcset="/assets/og/{{ post.data.ogImage | replace('.webp', '.avif') }}" type="image/avif">
             <source srcset="/assets/og/{{ post.data.ogImage }}" type="image/webp">
             {% if loop.first %}
               <img src="/assets/og/{{ post.data.ogImage }}" alt="{{ post.data.ogImageAlt or post.data.title }}" width="300" height="169" fetchpriority="high">
             {% else %}
               <img src="/assets/og/{{ post.data.ogImage }}" alt="{{ post.data.ogImageAlt or post.data.title }}" loading="lazy" width="300" height="169">
             {% endif %}
          </picture>
        </a>
        {% endif %}
        <div class="card-meta">{{ post.date | date("LLLL dd, yyyy") }}</div>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.description }}</p>
        <a href="{{ post.url }}">Read More &rarr;</a>
      </article>
    {% endfor %}
  </div>
</main>
