---
layout: 'base.njk'
---
<main class="wrap">
  <div class="breadcrumb">
    <a href="{{ '/' | url }}">Home</a> / 
    <span>Blog</span>
  </div>
  <h1 class="h1">Online Betting & Casino Guides for Bangladesh Players</h1>
<p>Your ultimate BoroJeet blog for expert cricket betting tips, live casino strategies, and the latest iGaming news in Bangladesh. Master the game with our in-depth analysis.</p>

  <div class="blog-nav" style="margin: 20px 0; display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
    <a href="/blog/search/" class="badge" style="background: var(--bdt); color: #000; font-weight: bold; text-decoration: none;">🔍 Search</a>
    <span class="muted">Topics:</span>
    <a href="/blog/tag/cricket/" class="badge" style="text-decoration: none;">Cricket</a>
    <a href="/blog/tag/casino/" class="badge" style="text-decoration: none;">Casino</a>
    <a href="/blog/tag/slots/" class="badge" style="text-decoration: none;">Slots</a>
    <a href="/blog/tag/live-casino/" class="badge" style="text-decoration: none;">Live Casino</a>
    <a href="/blog/tag/crash-games/" class="badge" style="text-decoration: none;">Crash Games</a>
    <a href="/blog/tag/fishing-games/" class="badge" style="text-decoration: none;">Fishing</a>
    <a href="/blog/tag/app/" class="badge" style="text-decoration: none;">App</a>
    <a href="/blog/tag/guide/" class="badge" style="text-decoration: none;">Guides</a>
  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ site.url }}/"
      },{
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "{{ site.url }}/blog/"
      }]
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "itemListElement": [
        {%- for post in posts -%}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ post.data.title }}",
          "url": "{{ site.url }}{{ post.url | url }}"
        }{%- if not loop.last -%},{%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>

  <div class="article-list">
    {% for post in posts %}
      <article class="card">
        {% if post.data.ogImage %}
        <a href="{{ post.url }}" class="card-image-link">
          <picture>
            {% if loop.first %}
              {# First post: prioritize image loading for LCP #}
              <source srcset="/assets/og/{{ post.data.ogImage | replace('.webp', '.avif') }}" type="image/avif">
              <source srcset="/assets/og/{{ post.data.ogImage }}" type="image/webp">
              <img src="/assets/og/{{ post.data.ogImage }}" alt="{{ post.data.ogImageAlt or post.data.title }}" width="300" height="169" fetchpriority="high">
            {% else %}
              {# Other posts: lazy load images #}
              <source srcset="/assets/og/{{ post.data.ogImage | replace('.webp', '.avif') }}" type="image/avif">
              <source srcset="/assets/og/{{ post.data.ogImage }}" type="image/webp">
              <img src="/assets/og/{{ post.data.ogImage }}" alt="{{ post.data.ogImageAlt or post.data.title }}" loading="lazy" width="300" height="169">
            {% endif %}
          </picture>
        </a>
        {% endif %}
        <div class="card-meta">{{ post.date | date("LLLL dd, yyyy") }}</div>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.description }}</p>
        <a href="{{ post.url }}">Read More &rarr;</a>
      </article>
    {% endfor %}
  </div>

  {% set currentPageNumber = pagination.pageNumber + 1 %}
  {% set totalPageCount = pagination.hrefs | length %}
  <nav class="pagination" aria-label="Pagination">
    {% if pagination.href.previous %}
      <a class="page-numbers page-nav" href="{{ pagination.href.previous }}">&laquo; Previous</a>
    {% endif %}

    {% if totalPageCount > 0 %}
      {% if currentPageNumber == 1 %}
        <span class="page-numbers current" aria-current="page">1</span>
      {% else %}
        <a class="page-numbers" href="{{ pagination.hrefs[0] }}">1</a>
      {% endif %}

      {% if currentPageNumber > 4 %}
        <span class="page-numbers dots" aria-hidden="true">&hellip;</span>
      {% endif %}

      {% for href in pagination.hrefs %}
        {% set pageNumber = loop.index %}
        {% if pageNumber > 1 and pageNumber < totalPageCount and pageNumber >= currentPageNumber - 2 and pageNumber <= currentPageNumber + 2 %}
          {% if pageNumber == currentPageNumber %}
            <span class="page-numbers current" aria-current="page">{{ pageNumber }}</span>
          {% else %}
            <a class="page-numbers" href="{{ href }}">{{ pageNumber }}</a>
          {% endif %}
        {% endif %}
      {% endfor %}

      {% if currentPageNumber < totalPageCount - 3 %}
        <span class="page-numbers dots" aria-hidden="true">&hellip;</span>
      {% endif %}

      {% if totalPageCount > 1 %}
        {% if currentPageNumber == totalPageCount %}
          <span class="page-numbers current" aria-current="page">{{ totalPageCount }}</span>
        {% else %}
          <a class="page-numbers" href="{{ pagination.hrefs[totalPageCount - 1] }}">{{ totalPageCount }}</a>
        {% endif %}
      {% endif %}
    {% endif %}

    {% if pagination.href.next %}
      <a class="page-numbers page-nav" href="{{ pagination.href.next }}">Next &raquo;</a>
    {% endif %}
  </nav>
</main>
