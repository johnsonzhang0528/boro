---
pagination:
  data: collections.post | reverse
  size: 10
  alias: posts
layout: "base.njk"
permalink: "/blog/{% if pagination.pageNumber > 0 %}page-{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
title: "BoroJeet Blog - Guides, Tips & News for Bangladesh"
description: "The official blog for BoroJeet Bangladesh. Get the latest tips, game guides for Crash/Slots, and news on bonuses."
---
<main class="wrap">
  <h1 class="h1">BoroJeet Blog: টিপস ও গাইড</h1>
  <p>Latest guides, tips, and news for players in Bangladesh.</p>

  <div class="article-list">
    {% for post in posts %}
      <article class="card">
        <div class="card-meta">{{ post.date | date: "%B %d, %Y" }}</div>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.description }}</p>
        <a href="{{ post.url }}">Read More &rarr;</a>
      </article>
    {% endfor %}
  </div>

  <nav class="pagination" aria-label="Pagination">
    {% if pagination.href.previous %}
      <a class="page-numbers" href="{{ pagination.href.previous }}">&laquo; Previous</a>
    {% endif %}
    {% for pageEntry in pagination.pages %}
      <a class="page-numbers {% if page.url == pagination.hrefs[loop.index0] %}current{% endif %}" href="{{ pagination.hrefs[loop.index0] }}">{{ loop.index }}</a>
    {% endfor %}
    {% if pagination.href.next %}
      <a class="page-numbers" href="{{ pagination.href.next }}">Next &raquo;</a>
    {% endif %}
  </nav>
</main>
