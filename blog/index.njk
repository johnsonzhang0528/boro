---
layout: 'base.njk'
---
<main class="wrap">
  <div class="breadcrumb">
    <a href="{{ '/' | url }}">Home</a> / 
    <span>Blog</span>
  </div>
  <h1 class="h1">Online Betting & Casino Guides for Bangladesh Players</h1>
<p>Your ultimate BoroJeet blog for expert cricket betting tips, live casino strategies, and the latest iGaming news in Bangladesh. Master the game with our in-depth analysis.</p>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "itemListElement": [
        {%- for post in posts -%}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": "{{ post.data.title }}",
          "url": "{{ site.url }}{{ post.url | url }}"
        }{%- if not loop.last -%},{%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>

  <div class="article-list">
    {% for post in posts %}
      <article class="card">
        <a href="{{ post.url }}" class="card-image-link">
          <picture>
            {% if loop.first %}
              {# First post: prioritize image loading for LCP #}
              <source srcset="/assets/og/{{ post.data.ogImage | replace('.webp', '.avif') }}" type="image/avif">
              <source srcset="/assets/og/{{ post.data.ogImage }}" type="image/webp">
              <img src="/assets/og/{{ post.data.ogImage }}" alt="{{ post.data.ogImageAlt or post.data.title }}" width="300" height="169" fetchpriority="high">
            {% else %}
              {# Other posts: lazy load images #}
              <source srcset="/assets/og/{{ post.data.ogImage | replace('.webp', '.avif') }}" type="image/avif">
              <source srcset="/assets/og/{{ post.data.ogImage }}" type="image/webp">
              <img src="/assets/og/{{ post.data.ogImage }}" alt="{{ post.data.ogImageAlt or post.data.title }}" loading="lazy" width="300" height="169">
            {% endif %}
          </picture>
        </a>
        <div class="card-meta">{{ post.date | date("LLLL dd, yyyy") }}</div>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.description }}</p>
        <a href="{{ post.url }}">Read More &rarr;</a>
      </article>
    {% endfor %}
  </div>

  <nav class="pagination" aria-label="Pagination">
    {% if pagination.href.previous %}
      <a class="page-numbers" href="{{ pagination.href.previous }}">&laquo; Previous</a>
    {% endif %}
    {% for pageEntry in pagination.pages %}
      <a class="page-numbers {% if page.url == pagination.hrefs[loop.index0] %}current{% endif %}" href="{{ pagination.hrefs[loop.index0] }}">{{ loop.index }}</a>
    {% endfor %}
    {% if pagination.href.next %}
      <a class="page-numbers" href="{{ pagination.href.next }}">Next &raquo;</a>
    {% endif %}
  </nav>
</main>
