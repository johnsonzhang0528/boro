---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {# Data-driven Promotion Pages (not in collections.all) #}
  {%- for category in promotions.all -%}
    {# Promotion Category Pages #}
    <url>
        <loc>{{ site.url }}/promotions/{{ category.slug }}/</loc>
        <lastmod>{{ category.date }}</lastmod>
    </url>
    {# Promotion Detail Pages #}
    {%- for item in category.items -%}
    <url>
        <loc>{{ site.url }}/promotions/{{ category.slug }}/{{ item.slug }}/</loc>
        <lastmod>{{ item.startDate }}</lastmod>
    </url>
    {%- endfor -%}
  {%- endfor -%}

  {# Add all published posts from the filtered collection #}
  {%- for page in collections.post %}
    <url>
      <loc>{{ site.url }}{{ page.url | url }}</loc>
      <lastmod>{{ page.date.toISOString().slice(0,10) }}</lastmod>
    </url>
  {%- endfor %}
  
  {# Add all other pages that are not posts #}
  {%- for page in collections.all %}
    {%- if page.data.tags and 'post' not in page.data.tags and page.url and page.data.eleventyExcludeFromCollections != true and not page.data.robots %}
      <url>
        <loc>{{ site.url }}{{ page.url | url }}</loc>
        <lastmod>{{ page.date.toISOString().slice(0,10) }}</lastmod>
      </url>
    {%- endif %}
  {%- endfor %}
</urlset>