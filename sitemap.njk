---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {# Data-driven Promotion Pages (not in collections.all) #}
  {%- for category in promotions.all -%}
    {# Promotion Category Pages #}
    <url>
        <loc>{{ site.url }}/promotions/{{ category.slug }}/</loc>
        <lastmod>{{ category.date }}</lastmod>
    </url>
    {# Promotion Detail Pages #}
    {%- for item in category.items -%}
    <url>
        <loc>{{ site.url }}/promotions/{{ category.slug }}/{{ item.slug }}/</loc>
        <lastmod>{{ item.startDate }}</lastmod>
    </url>
    {%- endfor -%}
  {%- endfor -%}

  {# Add all published posts from the filtered collection #}
  {%- for page in collections.post %}
    {%- if 'noindex' not in (page.data.robots or '') and not page.data.noindex %}
    <url>
      <loc>{{ site.url }}{{ page.url | url }}</loc>
      <lastmod>{{ (page.data.lastUpdated or page.date).toISOString().slice(0,10) }}</lastmod>
      {% if page.data.ogImage %}
      <image:image>
        <image:loc>{{ site.url }}/assets/og/{{ page.data.ogImage }}</image:loc>
        {% if page.data.ogImageAlt %}
        <image:caption>{{ page.data.ogImageAlt }}</image:caption>
        {% endif %}
      </image:image>
      {% endif %}
    </url>
    {%- endif %}
  {%- endfor %}
  
  {# Add all other pages that are not posts #}
  {%- for page in collections.all %}
    {%- if page.url and page.data.eleventyExcludeFromCollections != true and 'noindex' not in (page.data.robots or '') and not page.data.noindex and (not page.data.tags or 'post' not in page.data.tags) and '/blog/page-' not in page.url %}
      <url>
        <loc>{{ site.url }}{{ page.url | url }}</loc>
        <lastmod>{{ (page.data.lastUpdated or page.date).toISOString().slice(0,10) }}</lastmod>
      </url>
    {%- endif %}
  {%- endfor %}

  <url>
    <loc>{{ site.url }}/promotions/</loc>
    <lastmod>2025-11-14</lastmod>
  </url>
</urlset>