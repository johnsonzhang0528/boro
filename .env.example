# Copy to .env and replace only with local absolute paths. Never commit real credentials or tokens.
GSC_PROPERTY=sc-domain:example.com
GSC_SEARCH_TYPE=web
GSC_DATA_STATE=final
GSC_OAUTH_CLIENT_FILE=/absolute/path/to/.borojeet-gsc/credentials.json
GSC_OAUTH_TOKEN_FILE=/absolute/path/to/.borojeet-gsc/token.json
